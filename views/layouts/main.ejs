<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link href="/css/all.min.css" rel="stylesheet">
    <link href="/css/bootstrap.min.css" rel="stylesheet">
    <link href="/css/style.css" rel="stylesheet">
    <script src="/js/jquery.min.js"></script>
    <script src="/js/bootstrap.bundle.min.js"></script>
</head>
<body>
<div class="container vh100">
     <%- body %>
</div>
<div class="footer">
    <div class="container bg-footer">
        <div class="row">

            <div class="col-4 text-center gray-icon"><a href="/"><i class="fa-3x fa-solid fa-ranking-star"></i></a></div>
            <div class="col-4 text-center gray-icon">
                <% if (['/table', '/season'].includes(currentPath) && member.role == 'admin') { %>
                <a type="button" data-bs-toggle="modal" data-bs-target="#exampleModal">
                    <i class="fa-3x fa-solid fa-plus"></i>
                </a>

                <% } else if (currentPath.includes('/game')) { %>
                <a type="button" data-bs-toggle="modal"  class="boc" data-bs-target="#bocModal">
                    <i class="fa-3x fa-solid fa-plus"></i>
                </a>
                <% } else { %>
                <a href="/table"><i class="fa-3x fa-solid fa-cards"></i></a>
                <% } %>
            </div>
            <div class="col-4 text-center gray-icon"><a href="/season"><i class="fa-3x fa-solid fa-list"></i></a></div>
<!--            <div class="col-3 text-center gray-icon"><a href="/"><i class="fa-3x fa-solid fa-chart-simple"></i></a></div>-->
        </div>
    </div>
</div>
</body>
</html>