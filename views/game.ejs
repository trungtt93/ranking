<div id="ranking-list" class="list-group">
    <table class="leaderboard-table mt-3 game">
        <thead>
        <tr>
            <th scope="col">Nghiện</th>
            <th scope="col">Bốc</th>
            <th scope="col">Tổng</th>
            <th scope="col">Cashback</th>
            <th scope="col">Thuế</th>
            <th scope="col">Bú</th>
        </tr>
        </thead>
        <tbody id="member-list">
        </tbody>
    </table>
</div>
<div id="request-list">
    <div class="box hide-scrollbar" id="style-4">
        <ul id="first-list">

        </ul>
    </div>
</div>
<div class="modal fade" id="bocModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="exampleModalLabel">Bốc bát họ</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body cave-list">
                <img src="/images/boc.webp" alt="" width="200">
                Nhờ <%= table.member_name%> bốc giúp 1 bát, All-in
            </div>
            <div class="modal-footer justify-content-center">
                <button type="button" class="btn btn-outline-info" id="tableSubmit">Bốc</button>
            </div>
            <form action="/buyin" method="POST" id="buyinForm">
                <input type="hidden" name="member_id" value="<%= member.id%>">
                <input type="hidden" name="table_id" value="<%= table.table_id%>">
            </form>
        </div>
    </div>
</div>
<script>

    $(document).ready(function() {
        $('#tableSubmit').click(function() {
            $('#buyinForm').submit();
        });
      let tableId = '<%= table.table_id %>';
      loadMembers(tableId);
      loadTimeline(tableId);
      // setInterval(function () {
      //   loadMembers(tableId);
      //   loadTimeline(tableId);
      // }, 1000);
    });

    function loadMembers(tableId) {
      $.ajax({
        url: `/api/game/${tableId}/members`,
        method: 'GET',
        success: function (data) {
          let html = '';
          if (data.length > 0) {
            html += '<ul>';
            data.forEach(member => {
              console.log(member)
              let total = member.buyin * 50
              let amount = member.cashback - total
              let fee = calcFee(amount)
              html += `
              <tr class="rank-4">
                <td class="user">
                    <img src="${member.avatar}" alt="Avatar" class="avatar">
                    <span class="username">${member.name}</span>
                </td>
                <td class="score">${member.buyin}</td>
                <td class="score">${total}</td>
                <td class="score">${member.cashback}</td>
                <td class="score">${fee}</td>
                <td class="score">${amount}</td>
            </tr>
            `;
            });
            html += '</ul>';
          }
          $('#member-list').html(html);
        },
        error: function (err) {
          console.error('Error loading members:', err);
        }
      });
    }

    function loadTimeline(tableId) {
      $.ajax({
        url: `/api/game/${tableId}/timeline`,
        method: 'GET',
        success: function(data) {
          const $timeline = $('#first-list');
          $timeline.empty();

          if (!data || data.length === 0) {
            $timeline.append('<p style="text-align:center;">Chưa có nghiện nào trong bàn</p>');
            return;
          }
          data.forEach(item => {
            const statusMap = {
              approved: `Đã duyệt - ${item.updated_at}`,
              rejected: `Từ chối - ${item.updated_at}`,
              waiting: 'Chờ duyệt'
            };
            let status = statusMap[item.status] || 'Chờ duyệt';
            let isCave = "<%= table.member_id %>" == item.member_id
            let approveBtn = item.status === 'waiting' && isCave
              ? `<button class="btn btn-sm btn-danger" onclick="processRequest('${item.member_id}', 'rejected')"><i class="fa-solid fa-ban"></i></button>
                 <button class="btn btn-sm btn-info" onclick="processRequest('${item.member_id}', 'approved')"><i class="fa-solid fa-money-bill-1"></i></button>`
              : '';
            let html = `
              <li>
                <span></span>
                <div class="title"><strong>${item.member_name}</strong> xin bốc thêm 1 bát</div>
                <div class="info ${item.status}">${status}</div>
                <div class="time"><span>${item.created_at}</span></div>
                <div class="btnAction">${approveBtn}</div>
            </li>
            `;
            $timeline.append(html);
          });
        },
        error: function(xhr, status, error) {
          console.error('Error loading timeline:', error);
        }
      });
    }

    function processRequest(memberId, action) {
      let tableId = '<%= table.table_id %>';
      $.ajax({
        url: `/api/game/buyin/process`,
        method: 'POST',
        data: {
          table_id: tableId,
          member_id: memberId,
          action: action
        },
        success: function(response) {
          loadTimeline(tableId);
          loadMembers(tableId);
        },
        error: function(err) {
          console.error(`Error processing request ${action}:`, err);
        }
      });
    }
    function calcFee(total) {
      return total
    }
    // Load immediately once
</script>
<style>
    .btnAction {
        position: absolute;
        right: 10px;
        top: 15px;
        button {

        }
    }
</style>