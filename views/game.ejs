<div id="ranking-list" class="list-group">
    <table class="leaderboard-table mt-3 game">
        <thead>
        <tr>
            <th scope="col">Nghiện</th>
            <th scope="col">Bốc</th>
            <th scope="col">Tổng</th>
            <th scope="col">Cashback</th>
            <th scope="col">Trước Thuế</th>
            <th scope="col">Thuế</th>
            <th scope="col">Bú</th>
        </tr>
        </thead>
        <tbody id="member-list">
        </tbody>
    </table>
</div>
<div id="request-list">
    <div class="box hide-scrollbar" id="style-4">
        <ul id="first-list">

        </ul>
    </div>
</div>
<div class="modal fade" id="bocModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="exampleModalLabel">Bốc bát họ</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body cave-list">
                <img src="/images/boc.webp" alt="" width="200">
                Nhờ <%= table.member_name%> bốc giúp 1 bát, All-in
            </div>
            <div class="modal-footer justify-content-center">
                <button type="button" class="btn btn-outline-info" id="tableSubmit">Bốc</button>
            </div>
            <form action="/buyin" method="POST" id="buyinForm">
                <input type="hidden" name="member_id" value="<%= member.id%>">
                <input type="hidden" name="table_id" value="<%= table.table_id%>">
            </form>
        </div>
    </div>
</div>
<div class="modal fade" id="cashbackModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="">Cashback</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form action="/cashback" method="POST" id="cashbackForm">
                <div class="modal-body">
                    <div class="row mb-3">
                        <div class="col-6">
                            <div class="input-group">
                                <span class="input-group-text">$1</span>
                                <input type="number" class="form-control" name="list[chip1]" id="chip1" placeholder="0">
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="input-group ">
                                <span class="input-group-text">$5</span>
                                <input type="number" class="form-control" name="list[chip5]" id="chip5" placeholder="0">
                            </div>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-6">
                            <div class="input-group">
                                <span class="input-group-text">$10</span>
                                <input type="number" class="form-control" name="list[chip10]" id="chip10" placeholder="0">
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="input-group ">
                                <span class="input-group-text">$25</span>
                                <input type="number" class="form-control" name="list[chip25]" id="chip25" placeholder="0">
                            </div>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="offset-3 col-6">
                            <div class="input-group">
                                <span class="input-group-text">$50</span>
                                <input type="number" class="form-control" name="list[chip50]" id="chip50" placeholder="0">
                            </div>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-12">
                            <div class="input-group">
                                <span class="input-group-text">$ Tổng</span>
                                <input type="number" class="form-control" name="total" id="total" placeholder="0">
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer justify-content-center">
                    <input type="hidden" name="member_id" value="<%= member.id%>">
                    <input type="hidden" name="table_id" value="<%= table.table_id%>">
                    <button type="submit" class="btn btn-outline-info" id="cashbackSubmit">Bú</button>
                </div>
            </form>
        </div>
    </div>
</div>
<script>

    $(document).ready(function() {
        $('#tableSubmit').click(function() {
            $('#buyinForm').submit();
        });
      let tableId = '<%= table.table_id %>';
      loadMembers(tableId);
      loadTimeline(tableId);
      // setInterval(function () {
      //   loadMembers(tableId);
      //   loadTimeline(tableId);
      // }, 1000);

        $('#chip1, #chip5, #chip10, #chip25, #chip50').on('input', calculateTotal);
        function calculateTotal() {
            let total = (parseInt($('#chip1').val()) || 0) * 1 +
                (parseInt($('#chip5').val()) || 0) * 5 +
                (parseInt($('#chip10').val()) || 0) * 10 +
                (parseInt($('#chip25').val()) || 0) * 25 +
                (parseInt($('#chip50').val()) || 0) * 50;
            $('#total').val(total);
        }
    });

    function loadMembers(tableId) {
      $.ajax({
        url: `/api/game/${tableId}/members`,
        method: 'GET',
        success: function (data) {
          let html = '';
          if (data.length > 0) {
            html += '<ul>';
            let totalBuyin = 0;
            let totalTotal = 0;
            let totalCashback = 0;
            let totalFee = 0;
            let totalBefore = 0;

            data.forEach(member => {
              let before = member.cashback - member.total
              let beforeDisplay = `<p style="margin-bottom: 0">${before}<small>(${member.fee * 100}%)</small></p>`
              html += `
              <tr class="rank-4">
                <td class="user">
                    <img src="${member.avatar}" alt="Avatar" class="avatar">
                    <span class="username">${member.name}</span>
                </td>
                <td class="score">${member.buyin}</td>
                <td class="score">${member.total}</td>
                <td class="score">${member.cashback ? member.cashback : '0'}</td>
                <td class="score">${beforeDisplay}</td>
                <td class="score">${member.fee_amount}</td>
                <td class="score">${member.amount}</td>

                <td class="score"></td>
            </tr>
            `;
               totalBuyin += member.buyin;
               totalTotal += member.total;
               totalCashback += member.cashback;
               totalBefore += before;
               totalFee += member.fee_amount;

            });
                html += `
                <tr class="rank-4" style="font-weight: bold; background-color: #f0f0f0;">
                    <td class="user">
                        Tổng
                    </td>
                    <td class="score">${totalBuyin}</td>
                    <td class="score">${totalTotal}</td>
                    <td class="score">${totalCashback}</td>
                    <td class="score">${totalBefore}</td>
                    <td class="score">${totalFee}</td>
                    <td class="score"></td>

                    <td class="score"></td>`
            html += '</ul>';
          }
          $('#member-list').html(html);
        },
        error: function (err) {
          console.error('Error loading members:', err);
        }
      });
    }

    function loadTimeline(tableId) {
      $.ajax({
        url: `/api/game/${tableId}/timeline`,
        method: 'GET',
        success: function(data) {
          const $timeline = $('#first-list');
          $timeline.empty();

          if (!data || data.length === 0) {
            $timeline.append('<p style="text-align:center;">Chưa có nghiện nào trong bàn</p>');
            return;
          }
          data.forEach(item => {
            const statusMap = {
              approved: `Đã duyệt - ${item.updated_at}`,
              rejected: `Từ chối - ${item.updated_at}`,
              waiting: 'Chờ duyệt'
            };
            if (item.type == 'buyin') {
               title = `<strong>${item.member_name}</strong> xin bốc thêm 1 bát`;
            } else {
              list = JSON.parse(item.cashback_list);
              title = `<strong>${item.member_name}</strong> xin cashback <strong style="color: #20c997; font-size: 20px">$${item.amount ? item.amount : '0'}</strong>`;
              title += `<br>
                <small>
                  ${list.chip1 ? `$1 x ${list.chip1}, ` : ''}
                  ${list.chip5 ? `$5 x ${list.chip5}, ` : ''}
                  ${list.chip10 ? `$10 x ${list.chip10}, ` : ''}
                  ${list.chip25 ? `$25 x ${list.chip25}, ` : ''}
                  ${list.chip50 ? `$50 x ${list.chip50}, ` : ''}
                </small>
              `;
            }
            let status = statusMap[item.status] || 'Chờ duyệt';
            let isCave = "<%= table.member_id %>" == item.member_id
            let approveBtn = item.status === 'waiting' && isCave
              ? `<button class="btn btn-sm btn-danger" onclick="processRequest('${item.member_id}', 'rejected', '${item.type}')"><i class="fa-solid fa-ban"></i></button>
                 <button class="btn btn-sm btn-info" onclick="processRequest('${item.member_id}', 'approved', '${item.type}')"><i class="fa-solid fa-money-bill-1"></i></button>`
              : '';
            let html = `
              <li>
                <span></span>
                <div class="title">${title}</div>
                <div class="info ${item.status}">${status}</div>
                <div class="time"><span>${item.created_at}</span></div>
                <div class="btnAction">${approveBtn}</div>
            </li>
            `;
            $timeline.append(html);
          });
        },
        error: function(xhr, status, error) {
          console.error('Error loading timeline:', error);
        }
      });
    }

    function processRequest(memberId, action, type) {
      let tableId = '<%= table.table_id %>';
      let url = type == 'buyin' ? '/api/game/buyin/process' : '/api/game/cashback/process';
      $.ajax({
        url: url,
        method: 'POST',
        data: {
          table_id: tableId,
          member_id: memberId,
          action: action
        },
        success: function(response) {
          loadTimeline(tableId);
          loadMembers(tableId);
        },
        error: function(err) {
          console.error(`Error processing request ${action}:`, err);
        }
      });
    }
</script>
<style>
    .btnAction {
        position: absolute;
        right: 10px;
        top: 15px;
        button {

        }
    }
</style>