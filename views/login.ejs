<div class="login-page">
    <div class="row">
        <div class="col-lg-6 offset-lg-3">
            <div class="bg-dark shadow rounded">
                <div class="row">
                    <div class="form-left h-100 py-5 px-5 text-center">
                        <% if (typeof error !== 'undefined') { %>
                        <div class="alert alert-danger" role="alert">
                            <%= error %>
                        </div>
                        <% } %>
                        <form action="/login" method="POST" class="row g-4">
                            <div class="col-12">
                                <div class="input-group">
                                    <div class="input-group-text"><i class="fa fa-user"></i></div>
                                    <input type="text" class="form-control" name="username" required placeholder="Username">
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="input-group">
                                    <div class="input-group-text"><i class="fa fa-lock"></i></div>
                                    <input type="password" class="form-control" name="password" required placeholder="Password">
                                </div>
                            </div>
                            <div class="col-12 text-center">
                                <button type="submit" class="btn btn-outline-info px-4 mt-4"><i class="fa-solid fa-card-club"></i> Quất</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
