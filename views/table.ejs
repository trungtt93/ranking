<div id="ranking-list" class="list-group">
    <h3></h3>
    <table class="leaderboard-table mt-3">
        <tbody>
        <% tables.forEach((i, index) => { %>
        <tr class="rank-4 table-item" onclick="window.location.href='/game/<%= i.table_id %>'">
            <td class="rank">#<%= i.table_id %></td>
            <td class="user">
                <img src="<%= i.avatar %>" alt="Avatar" class="avatar">
                <span class="username">
                     <% if(i.is_today) { %>
                        <%= i.title %> <strong style="color: #e67e22"><%= i.member_name %></strong>
                    <% } else { %>
                    <span style="color: #5c636a">
                         <%= i.title %> <strong> <%= i.member_name %></strong>
                    </span>
                    <% } %>
                </span>
            </td>
            <td class="score" style="<%= i.is_today ? '' : 'color: #5c636a' %>"><%= i.created_at %></td>
        </tr>
        <% }) %>
        </tbody>
    </table>
    <div class="modal fade" id="exampleModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content bg-dark">
                <div class="modal-header">
                    <h1 class="modal-title fs-5" id="exampleModalLabel">Chọn Cave</h1>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body cave-list">
                    <ul>
                        <% members.forEach((i, index) => { %>
                        <li data-member="<%= i.id %>">
                            <img src="<%= i.avatar %>" alt="">
                            <span><%= i.name %></span>
                        </li>
                        <% }) %>
                    </ul>
                </div>
                <div class="modal-footer justify-content-center">
                    <button type="button" class="btn btn-outline-info" id="tableSubmit">Chơi</button>
                </div>
                <form action="/table" method="POST" id="tableForm">
                    <input type="hidden" name="member_id" id="caveId" value="">
                </form>
            </div>
        </div>
    </div>
</div>
<style>
    .table-item {
        border: 1px solid transparent;
        border-bottom-color: #444;
        cursor: pointer;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }
    .table-item:hover {
        border-color: #ffc500 !important;
        font-size: 20px;
    }
    .cave-list {
        ul  {
            padding: 0;
        }
        li {
            list-style: none;
            padding: 5px 20px;
            cursor: pointer;
            border: 1px solid transparent;
        }
        img {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            margin-right: 10px;
        }
        li:nth-child(odd) {
            background: #7777
        }
        li:nth-child(even) {
            background: #9999
        }
        li:hover, li.active {
            background: #d8d8d8;
            border-color: yellow ;
        }
    }
    .modal-header, .modal-footer{
        border-bottom: none !important;
        border-top: none !important;
    }
</style>
<script>
    $(document).ready(function() {
        $('.cave-list li').click(function() {
            $('.cave-list li').removeClass('active');
            $(this).addClass('active');
            const memberId = $(this).data('member');
            $('#caveId').val(memberId);
        });
        $('#tableSubmit').click(function() {
            if ($('#caveId').val()) {
                $('#tableForm').submit();
            } else {
                alert('Chọn Cave trước khi chơi đi đã!');
            }
        });
    });
</script>